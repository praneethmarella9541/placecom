# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
# Call recording transcription: twilio | openai | auto (default auto = Twilio first, OpenAI if Twilio fails).
# Programmable Voice REST recordings often cannot use Twilio’s classic transcription API; auto needs OPENAI_API_KEY for fallback.
# CALL_TRANSCRIPTION_PROVIDER=auto
# Optional OpenAI speech model when using openai or auto fallback (default gpt-4o-mini-transcribe).
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# OPENAI_TRANSCRIPTION_TIMEOUT_MS=120000
# Optional: override model (default gpt-5-mini)
# OPENAI_EXTRACTION_MODEL=gpt-5-mini
# Optional: trim each email body before the API (2000–24000 chars; default 8000). Lower = faster bulk, less tail context.
# OPENAI_EXTRACTION_MAX_BODY_CHARS=10000
# Optional: emails per OpenAI call (default 14, max 30). Higher = fewer model round-trips per HTTP batch.
# OPENAI_EXTRACTION_SUB_BATCH=14
# Optional: max concurrent OpenAI calls when one HTTP batch splits into many sub-batches (default 10, max 20).
# OPENAI_EXTRACTION_MAX_PARALLEL=10
# Optional: per-request timeout in ms (default 240000)
# OPENAI_TIMEOUT_MS=240000
# Optional: emails per /api/extract POST — fewer browser round-trips (default 50, max 80). Set NEXT_PUBLIC_ too so the dashboard matches.
# EXTRACT_HTTP_BATCH_SIZE=50
# NEXT_PUBLIC_EXTRACT_HTTP_BATCH_SIZE=50
# Optional: USD per 1M tokens if OpenAI changes list pricing (defaults: 0.25 in / 2 out for gpt-5-mini)
# OPENAI_GPT4O_INPUT_USD_PER_MTOK=2.5
# OPENAI_GPT4O_OUTPUT_USD_PER_MTOK=10

# Optional: parallel Gmail full-message downloads (default 12, max 32)
# GMAIL_FETCH_CONCURRENCY=12

# Gmail → OpenAI: include inline / attachment image/* parts as vision inputs (default on). Set false to skip.
# EXTRACTION_INCLUDE_IMAGE_PARTS=true
# Optional: max images per message (default 4, max 12), max decoded bytes per image (default 400000)
# EXTRACTION_MAX_IMAGES_PER_EMAIL=4
# EXTRACTION_MAX_IMAGE_BYTES=400000
# Optional: OpenAI vision detail for those images: low | high | auto (default low — cheaper/faster)
# OPENAI_EXTRACTION_IMAGE_DETAIL=low

# Same Google OAuth Web Client ID as in Supabase Auth → Google (public; not a secret)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Web client secret (Google Cloud Console → Credentials → OAuth client). Server-only:
# used to refresh long-lived Gmail access for admins/staff without repeated consent.
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Meet: events are created on the organizer calendar (Meet host = that account).
# Defaults: g24072@astra.xlri.ac.in (host), chetangalla248@gmail.com (always invited).
#
# Easiest setup (no Cloud Console): sign in to the app with Google as the organizer once.
# GET /api/meet-organizer/status shows whether credentials were saved.
#
# Alternatives: share organizer calendar with admin, or GOOGLE_MEET_ORGANIZER_REFRESH_TOKEN
# via npm run auth:meet-organizer (needs GOOGLE_OAUTH_CLIENT_SECRET in Cloud Console).
# GOOGLE_MEET_ORGANIZER_EMAIL=g24072@astra.xlri.ac.in
# GOOGLE_MEET_ORGANIZER_ADMIN_EMAIL=chetangalla248@gmail.com

# App URL for tracking pixels (production URL when deployed, localhost for dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron → /api/cron/gmail-push (mobile mail push). Set in Vercel project env.
# CRON_SECRET=generate-a-long-random-string

# Twilio Voice (Programmable Voice)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
TWILIO_AGENT_PHONE=+1...
# Call recording transcription uses Twilio’s Recording Transcription API (see Twilio Voice docs). Optional tuning:
# Max recording length in seconds before /api/calls/transcribe rejects (default 120).
# TWILIO_RECORDING_TRANSCRIPTION_MAX_SECONDS=120
# BCP-47 language for Twilio (optional).
# TWILIO_TRANSCRIPTION_LANGUAGE=en-US
# Poll interval and max wait while Twilio processes the transcript (defaults 2000 ms and 120000 ms).
# TWILIO_TRANSCRIPTION_POLL_MS=2000
# TWILIO_TRANSCRIPTION_MAX_WAIT_MS=120000
# Optional: public HTTPS base Twilio can reach for recording webhooks (use ngrok URL in dev).
# If unset, NEXT_PUBLIC_APP_URL is used. Recording callbacks require https in production.
# TWILIO_WEBHOOK_BASE_URL=https://your-ngrok-or-prod-host.example

# Twilio WhatsApp
# --- Sandbox (trial / "Try WhatsApp") ---
# Recipients must WhatsApp the join code to Twilio's sandbox number first. Outbound "From" is NOT your voice number.
# TWILIO_WHATSAPP_SANDBOX=true
# Optional: paste exact "From" from Console if not the default +1 415 523 8886
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# --- Production (Meta-approved sender on your number) ---
# TWILIO_WHATSAPP_SANDBOX=false
# TWILIO_WHATSAPP_FROM=whatsapp:+15551234567
# Inbound webhook (Sandbox or production sender): POST to {TWILIO_WEBHOOK_BASE_URL}/api/twilio/whatsapp

# Exotel Voice (Programmable Connect) — assign DIDs per team member in Admin → Team
# EXOTEL_SID=your_account_sid
# EXOTEL_API_KEY=...
# EXOTEL_API_TOKEN=...
# Comma-separated virtual numbers (one per staff/committee member in Team UI)
# EXOTEL_VIRTUAL_NUMBERS=+919513886363,+919876543210
# Legacy single-DID fallback if EXOTEL_VIRTUAL_NUMBERS is unset:
# EXOTEL_VIRTUAL_NUMBER=+919513886363
# Optional fallbacks when a DID has no team assignment (prefer DB assignment):
# INCOMING_AGENT_NUMBER=+918056101540
# INCOMING_DEFAULT_USER_ID=<auth-user-uuid-for-call-logs>
# WhatsApp (Exotel v2 API — same API Key/Token as voice). Host MUST match your Exotel cluster:
#   Singapore (default, same as voice v1 in this app): api.exotel.com
#   Mumbai / India WhatsApp: api.in.exotel.com
# EXOTEL_API_HOST=api.in.exotel.com
# Or: EXOTEL_CLUSTER=mumbai
# Public app URL for Exotel webhooks (production or ngrok)
# TWILIO_WEBHOOK_BASE_URL=https://your-app.vercel.app
# Configure in Exotel Dashboard → WhatsApp → Webhooks:
#   POST {TWILIO_WEBHOOK_BASE_URL}/api/exotel/whatsapp
# Approved template for first message / outside 24h session (Marketing templates need opt-in):
# EXOTEL_WHATSAPP_TEMPLATE_NAME=initial_conversation
# EXOTEL_WHATSAPP_TEMPLATE_LANGUAGE=en
# EXOTEL_WHATSAPP_TEMPLATE_PARAM_COUNT=2
