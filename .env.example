# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
# Optional: override model (default gpt-5-mini)
# OPENAI_EXTRACTION_MODEL=gpt-5-mini
# Optional: trim each email body before the API (2000–24000 chars; default 8000). Lower = faster bulk, less tail context.
# OPENAI_EXTRACTION_MAX_BODY_CHARS=10000
# Optional: emails per OpenAI call (default 14, max 30). Higher = fewer model round-trips per HTTP batch.
# OPENAI_EXTRACTION_SUB_BATCH=14
# Optional: max concurrent OpenAI calls when one HTTP batch splits into many sub-batches (default 10, max 20).
# OPENAI_EXTRACTION_MAX_PARALLEL=10
# Optional: per-request timeout in ms (default 240000)
# OPENAI_TIMEOUT_MS=240000
# Optional: emails per /api/extract POST — fewer browser round-trips (default 50, max 80). Set NEXT_PUBLIC_ too so the dashboard matches.
# EXTRACT_HTTP_BATCH_SIZE=50
# NEXT_PUBLIC_EXTRACT_HTTP_BATCH_SIZE=50
# Optional: USD per 1M tokens if OpenAI changes list pricing (defaults: 0.25 in / 2 out for gpt-5-mini)
# OPENAI_GPT4O_INPUT_USD_PER_MTOK=2.5
# OPENAI_GPT4O_OUTPUT_USD_PER_MTOK=10

# Optional: parallel Gmail full-message downloads (default 12, max 32)
# GMAIL_FETCH_CONCURRENCY=12

# Optional: sustained Gmail quota units/min per mailbox, shared by every subsystem
# (default 4000, clamped to 9000). Gmail's own limit is 250 units/sec per user, so
# the bucket also caps how much it will bank — see lib/gmail-quota.ts. A metadata
# fetch costs 5 units, so 6000 works out to roughly 1200 messages/min in the
# contact sync. Raise it a step at a time and watch for "[gmail-quota] throttled".
# GMAIL_QUOTA_UNITS_PER_MIN=6000

# Gmail → OpenAI: include inline / attachment image/* parts as vision inputs (default on). Set false to skip.
# EXTRACTION_INCLUDE_IMAGE_PARTS=true
# Optional: max images per message (default 4, max 12), max decoded bytes per image (default 400000)
# EXTRACTION_MAX_IMAGES_PER_EMAIL=4
# EXTRACTION_MAX_IMAGE_BYTES=400000
# Optional: OpenAI vision detail for those images: low | high | auto (default low — cheaper/faster)
# OPENAI_EXTRACTION_IMAGE_DETAIL=low

# Same Google OAuth Web Client ID as in Supabase Auth → Google (public; not a secret)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Web client secret (Google Cloud Console → Credentials → OAuth client). Server-only:
# used to refresh long-lived Gmail access for admins/staff without repeated consent.
GOOGLE_OAUTH_CLIENT_SECRET=

# logo.dev Search API secret key (dashboard → API Keys → secret key, starts "sk_" —
# NOT the "pk_" publishable key). Server-only: resolves real company names from a
# domain for the contact sync (lib/company-enrichment.ts). Falls back to a syntactic
# guess if unset. Set in Vercel project env too, not just here.
LOGO_DEV_SECRET_KEY=

# --- /configs (platform module toggles) ---
# Comma-separated emails allowed to open /configs and switch whole modules on or
# off for every user on this deployment. Server-only and deliberately NOT
# NEXT_PUBLIC_, so the list never ships to the browser; it is also not editable
# from the UI, so nobody who has access can grant it to someone else. Leave
# unset and /configs 404s for everyone.
# Requires migration 0066_platform_module_config.sql.
# CONFIGS_ALLOWED_EMAILS=you@thenucleus.in,cofounder@thenucleus.in

# App URL for tracking pixels (production URL when deployed, localhost for dev)
# Production: https://www.thenucleus.in
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: pause background Gmail thread body prefetch (?prefetch=1). Mobile app uses EXPO_PUBLIC_DISABLE_MAIL_THREAD_PREFETCH.
# NEXT_PUBLIC_DISABLE_MAIL_THREAD_PREFETCH=1

# External scheduler (cron-job.org) — shared by BOTH cron routes:
#   /api/cron/contact-sync  and  /api/cron/sequences (the sequence send scheduler).
# Without this set, /api/cron/sequences returns 503 and no scheduled sequence
# email is ever sent. Setup walkthrough: docs/sequence-cron-setup.md
# Set in Vercel project env (Settings → Environment Variables), not just here —
# the deployed function reads Vercel's copy, not your local .env.
# Generate with: openssl rand -hex 32
# CRON_SECRET=generate-a-long-random-string

# owner_user_id (auth.users.id / google_mailbox_credentials.owner_user_id) of the
# mailbox the cron-triggered contact sync should run against — there's no logged-in
# user to infer this from since it runs unattended. Find it via:
#   select owner_user_id, gmail_address from google_mailbox_credentials;
# CONTACT_SYNC_MAILBOX_OWNER_ID=

# --- WhatsApp (restored module; switch it on in /configs) ---
# Two providers are supported. Pick one; the /whatsapp status panel reports
# which it resolved and whether sending is configured.
#
# Provider A — Exotel WhatsApp (v2 API, same SID/API Key/Token as SMS below).
# Host MUST match your Exotel cluster:
#   Singapore (default): api.exotel.com
#   Mumbai / India WhatsApp: api.in.exotel.com
# EXOTEL_API_HOST=api.in.exotel.com
# Or: EXOTEL_CLUSTER=mumbai
# Inbound webhook — Exotel Dashboard → WhatsApp → Webhooks:
#   POST {EXOTEL_WEBHOOK_BASE_URL}/api/exotel/whatsapp
# Optional: pin a WABA when the account has several (otherwise all are scanned).
# EXOTEL_WABA_ID=
# Approved templates are required for a first message or outside the 24h session
# window. Prefer the JSON array when you have several; otherwise edit
# config/whatsapp-templates.json, which loads automatically when this is unset.
# EXOTEL_WHATSAPP_TEMPLATES=[{"name":"initial_conversation","languageCode":"en","bodyParamCount":2,"label":"Short intro","preview":"Hi {{1}}, this is {{2}}"}]
# Or a single template via:
# EXOTEL_WHATSAPP_TEMPLATE_NAME=initial_conversation
# EXOTEL_WHATSAPP_TEMPLATE_LANGUAGE=en
# EXOTEL_WHATSAPP_TEMPLATE_PARAM_COUNT=2
# EXOTEL_WHATSAPP_TEMPLATE_LABEL=First outreach
# EXOTEL_WHATSAPP_TEMPLATE_PREVIEW=Hi {{1}}, this is {{2}}
#
# Provider B — Twilio WhatsApp. Needs TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN.
# Sandbox (trial): recipients must WhatsApp the join code to Twilio's sandbox
# number first, and the outbound "From" is Twilio's sandbox number.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_SANDBOX=true
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Production (Meta-approved sender on your own number):
# TWILIO_WHATSAPP_SANDBOX=false
# TWILIO_WHATSAPP_FROM=whatsapp:+15551234567
# Inbound webhook: POST {EXOTEL_WEBHOOK_BASE_URL}/api/twilio/whatsapp

# Exotel (SMS) — assign DIDs per team member in Admin → Team
# EXOTEL_SID=your_account_sid
# EXOTEL_API_KEY=...
# EXOTEL_API_TOKEN=...
# Admin → Team loads +91 ExoPhones from Exotel API (IncomingPhoneNumbers). Optional env fallback if API fails:
# EXOTEL_VIRTUAL_NUMBERS=+919513886363,+91731462415
# Legacy single-DID fallback:
# EXOTEL_VIRTUAL_NUMBER=+919513886363
# Public HTTPS base for Exotel webhooks (production or ngrok). If unset, NEXT_PUBLIC_APP_URL is used.
# EXOTEL_WEBHOOK_BASE_URL=https://www.thenucleus.in
# Each staff member sends from the Exotel number assigned to them in Admin → Team
# (profiles.exotel_virtual_number).
# Inbound SMS webhook (Exotel Dashboard → ExoPhone → Incoming SMS):
#   POST {EXOTEL_WEBHOOK_BASE_URL}/api/exotel/sms
# Outbound delivery reports (set as StatusCallback):
#   POST {EXOTEL_WEBHOOK_BASE_URL}/api/exotel/sms/status
# Message category: transactional (default) | promotional
# EXOTEL_SMS_TYPE=transactional

# PostHog — user activity tracking (components/PostHogProvider.tsx, PostHogIdentify.tsx).
# Project Settings → Project API Key, in your PostHog project.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Ingestion host for your project's region: us.i.posthog.com | eu.i.posthog.com | your self-hosted URL
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Gmail quota governor (lib/gmail-quota.ts) ---
# Units per minute this app allows itself per mailbox. Gmail's own per-user
# ceiling for this project is 6000; the margin absorbs the fact that each server
# instance holds its own bucket, so N warm instances each spend up to this much.
GMAIL_QUOTA_UNITS_PER_MIN=5200
# Units held back from background scans (contact sync, CRM classify, bulk fetch)
# while someone is actively using the app, so interactive requests never queue
# behind a 500-message sync page. Released to batch work once the app goes idle.
GMAIL_QUOTA_INTERACTIVE_RESERVE=1200
